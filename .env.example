# Variables que se resuelven en el BUILD.
#
# No confundir con `.dev.vars`, que son las variables que lee el Worker en
# ejecución (ahí va la clave de Resend). Este fichero lo lee Astro al generar
# el sitio, así que cambiar un valor exige volver a construir.
#
# Copia este fichero a `.env` para trabajar en local. `.env` está en .gitignore.
# En producción estas variables viven en los ajustes de *build* del Worker,
# en el panel de Cloudflare.

# Entorno: `production` o `staging`. Obligatoria, sin valor por defecto.
# La lee también el plugin de Cloudflare para decidir a qué Worker se despliega,
# así que debe coincidir con un bloque `env.*` de wrangler.jsonc.
CLOUDFLARE_ENV=production

# inConstruction: con `true`, todas las rutas sirven la página de obras
# y no se genera sitemap.
SETTINGS={"inConstruction":false}
