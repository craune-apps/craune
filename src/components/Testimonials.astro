---
import SectionHeading from './SectionHeading.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Iniciales para el avatar, sin necesidad de imágenes. */
const initials = (name: string) =>
	name
		.split(' ')
		.slice(0, 2)
		.map((word) => word[0] ?? '')
		.join('')
		.toUpperCase();
---

<section class="section-pad">
	<div class="container-craune">
		<SectionHeading eyebrow={t.testimonials.eyebrow} title={t.testimonials.title} />

		<div class="mt-16 grid gap-5 lg:grid-cols-3">
			{
				t.testimonials.items.map((item, index) => (
					<figure
						class="card reveal flex flex-col gap-6 p-7 lg:p-8"
						style={`transition-delay: ${index * 80}ms;`}
					>
						<svg
							width="26"
							height="26"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
							class="text-gold/25"
						>
							<path d="M9.6 5.4c-3.3 1.5-5.4 4.5-5.4 8.1v5.1h6.6v-6.6H7.5c0-2 1-3.5 2.9-4.4l-.8-2.2Zm9.3 0c-3.3 1.5-5.4 4.5-5.4 8.1v5.1H20v-6.6h-3.3c0-2 1-3.5 2.9-4.4l-.7-2.2Z" />
						</svg>

						<blockquote class="leading-relaxed text-bone/90">{item.quote}</blockquote>

						<figcaption class="mt-auto flex items-center gap-3 border-t border-line-soft pt-5">
							<span
								class="grid size-9 shrink-0 place-items-center rounded-full bg-gold/10 font-display text-xs font-semibold text-gold"
								aria-hidden="true"
							>
								{initials(item.author)}
							</span>
							<span class="flex flex-col">
								<span class="text-sm font-medium">{item.author}</span>
								<span class="text-xs text-faint">{item.role}</span>
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
